# DocAI - Environment Variables Configuration
# Copy this file to .env and add your API key

# Google Gemini API Key (Recommended - Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Alternative LLM Provider: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
DEFAULT_MODEL=gemini-2.0-flash
# Alternative models: gemini-1.5-flash, gemini-1.5-pro, gpt-4o-mini
