# DocAI - Environment Variables Configuration
# You do NOT need to edit this file manually.
# Just run:  python run_app.py
# The launcher will prompt you for your API key and save it automatically.

# Google Gemini API Key — get one free at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default model (auto-set by the launcher)
DEFAULT_MODEL=gemini-2.0-flash
# Available models: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro, gemini-2.5-flash
